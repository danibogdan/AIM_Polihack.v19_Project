generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String?
  googleId      String?  @unique
  displayName   String?
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  gdprConsent   Boolean  @default(false)
  gdprConsentAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships TeamMember[]

  actions     Action[]     @relation("ActionCreatedBy")
  simulations Simulation[] @relation("SimulationCreatedBy")
  incidents   Incident[]   @relation("IncidentReportedBy")
  refreshTokens RefreshToken[]
  emailTokens   EmailToken[]
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String         @id @default(cuid())
  userId    String
  token     String         @unique
  type      EmailTokenType
  used      Boolean        @default(false)
  expiresAt DateTime
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Company {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  teams Team[]
}

model Team {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  members            TeamMember[]
  actions            Action[]
  simulations        Simulation[]
  jobs               Job[]
  incidents          Incident[]
  incidentEmbeddings IncidentEmbedding[]
}

model TeamMember {
  id     String @id @default(cuid())
  userId String
  teamId String
  role   String @default("member")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Action {
  id          String @id @default(cuid())
  teamId      String
  createdById String

  name        String
  description String

  aiScore  Int?
  aiReview String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id])
  createdBy User @relation("ActionCreatedBy", fields: [createdById], references: [id])

  simulationNodes SimulationNode[]
}

model Simulation {
  id          String @id @default(cuid())
  teamId      String
  createdById String

  title       String
  description String?

  aiReview           String?
  aiRiskScore        Int?
  aiSuggestedProcess Json?

  status String @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team      Team @relation(fields: [teamId], references: [id])
  createdBy User @relation("SimulationCreatedBy", fields: [createdById], references: [id])

  nodes SimulationNode[]
  edges SimulationEdge[]
  jobs  Job[]
}

model SimulationNode {
  id           String  @id @default(cuid())
  simulationId String
  actionId     String?

  label  String
  prompt String

  positionX Float
  positionY Float

  orderIndex Int?

  simulation Simulation @relation(fields: [simulationId], references: [id])
  action     Action?    @relation(fields: [actionId], references: [id])
}

model SimulationEdge {
  id           String @id @default(cuid())
  simulationId String

  sourceNodeId String
  targetNodeId String

  simulation Simulation @relation(fields: [simulationId], references: [id])
}

model Job {
  id           String  @id @default(cuid())
  teamId       String
  simulationId String?

  title       String
  description String?
  status      String  @default("pending")

  machineBrand String?
  machineModel String?
  machineType  String?
  machineYear  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team       Team        @relation(fields: [teamId], references: [id])
  simulation Simulation? @relation(fields: [simulationId], references: [id])

  steps     JobStep[]
  incidents Incident[]
}

model JobStep {
  id    String @id @default(cuid())
  jobId String

  name       String
  prompt     String?
  status     String  @default("pending")
  orderIndex Int

  startedAt   DateTime?
  completedAt DateTime?

  job       Job        @relation(fields: [jobId], references: [id])
  incidents Incident[]
}

model Incident {
  id               String  @id @default(cuid())
  teamId           String
  jobId            String
  jobStepId        String?
  reportedByUserId String?

  taskName        String?
  canonicalAction String?

  title       String
  description String

  machineBrand String?
  machineModel String?
  machineType  String?
  machineYear  Int?

  problem    String?
  cause      String?
  solution   String?
  prevention String?

  severity         String?
  durationExtraMin Int?

  embeddingText String?

  createdAt DateTime @default(now())

  team       Team               @relation(fields: [teamId], references: [id])
  job        Job                @relation(fields: [jobId], references: [id])
  jobStep    JobStep?           @relation(fields: [jobStepId], references: [id])
  reportedBy User?              @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id])
  embedding  IncidentEmbedding?
}

model ProcessFlow {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  nodesJson   Json     @default("[]")
  edgesJson   Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("process_flows")
}

model IncidentEmbedding {
  id         String                      @id @default(cuid())
  incidentId String                      @unique
  teamId     String
  model      String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
